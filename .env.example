# Set by the Vercel Supabase integration
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public (anon / publishable) key, used only for sign-in. Safe in the browser: RLS blocks all table access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.abundanthomedesign.com

# Analytics (production only)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_AHREFS_KEY=
# Google Search Console HTML-tag verification code (content="..." value only)
NEXT_PUBLIC_GSC_VERIFICATION=

# Where Nancy's Squarespace site lives after the DNS move, e.g. https://members.abundanthomedesign.com
# Defaults to https://members.abundanthomedesign.com. Set to "off" to disable.
LEGACY_SITE_ORIGIN=

# Shop and email (see claude/shop-and-email.md in the project)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
SIGNING_SECRET=
CRON_SECRET=
MAILING_ADDRESS=
EMAIL_SENDING_ENABLED=

# Admin: a shared password, and/or accounts allowed in by email (comma-separated)
ADMIN_PASSWORD=
ADMIN_EMAILS=
